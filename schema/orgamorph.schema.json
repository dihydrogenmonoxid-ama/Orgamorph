{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orgamorph.invalid/schema/orgamorph.schema.json",
  "title": "Orgamorph-Dokument (schemaVersion 1)",
  "description": "Dateiformat *.orgamorph.json. Unbekannte Felder sind erlaubt und bleiben beim Speichern erhalten.",
  "type": "object",
  "required": ["format", "schemaVersion", "meta", "units"],
  "properties": {
    "format": {
      "const": "orgamorph"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z]_[a-z0-9]{10}$",
      "description": "Dokument-ID (Präfix d_), Schlüssel für den Browser-Speicher. Fehlt sie, wird beim Laden eine erzeugt."
    },
    "meta": {
      "type": "object",
      "required": ["title"],
      "properties": {
        "title": {
          "type": "string"
        },
        "organization": {
          "type": "string"
        },
        "department": {
          "type": "string",
          "description": "Plankopf: erstellende Organisationseinheit/Abteilung"
        },
        "author": {
          "type": "string",
          "description": "Plankopf: Ersteller (Name), personenbezogen, optional"
        },
        "asOf": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "created": {
          "type": "string",
          "format": "date-time"
        },
        "modified": {
          "type": "string",
          "format": "date-time"
        },
        "logo": {
          "type": "string",
          "maxLength": 400000,
          "pattern": "^data:image\\/(png|jpeg|webp|svg\\+xml);base64,[A-Za-z0-9+/]+=*$",
          "description": "Plankopf: Logo als data:-URL"
        }
      }
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "description": "Array-Reihenfolge = Geschwisterreihenfolge. Genau eine Wurzel (parentId null).",
      "items": {
        "$ref": "#/$defs/unit"
      }
    },
    "topics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/topic"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      }
    },
    "settings": {
      "type": "object",
      "properties": {
        "levelNames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "spanOfControlHint": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "view": {
      "$ref": "#/$defs/view"
    }
  },
  "$defs": {
    "unit": {
      "type": "object",
      "required": ["id", "parentId", "name"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z]_[a-z0-9]{10}$"
        },
        "parentId": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-z]_[a-z0-9]{10}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "shortName": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "responsibilities": {
          "type": "string"
        },
        "isStaff": {
          "type": "boolean"
        },
        "lead": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string"
            },
            "code": {
              "type": "string"
            },
            "positionNumber": {
              "type": "string"
            },
            "holder": {
              "type": "string",
              "description": "personenbezogen, optional"
            }
          }
        },
        "note": {
          "type": "string"
        }
      }
    },
    "topic": {
      "type": "object",
      "required": ["id", "title", "type", "period", "participants", "color"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z]_[a-z0-9]{10}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "shortName": {
          "type": "string"
        },
        "type": {
          "enum": ["project", "workingGroup", "committee", "crossCutting", "other"]
        },
        "period": {
          "type": "object",
          "properties": {
            "from": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "to": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          },
          "description": "ohne to = dauerhaft bzw. offen; from ≤ to"
        },
        "participants": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["unitId", "role"],
            "properties": {
              "unitId": {
                "type": "string",
                "pattern": "^[a-z]_[a-z0-9]{10}$"
              },
              "role": {
                "enum": ["lead", "member"]
              }
            }
          }
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "relation": {
      "type": "object",
      "required": ["id", "from", "to", "kind"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z]_[a-z0-9]{10}$"
        },
        "from": {
          "type": "string",
          "pattern": "^[a-z]_[a-z0-9]{10}$"
        },
        "to": {
          "type": "string",
          "pattern": "^[a-z]_[a-z0-9]{10}$"
        },
        "kind": {
          "enum": ["reportsTo", "directs", "informs", "coordinates"]
        },
        "note": {
          "type": "string"
        }
      }
    },
    "view": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": ["tree", "star", "network"]
        },
        "label": {
          "type": "object",
          "properties": {
            "shortNames": {
              "type": "boolean"
            },
            "leadCode": {
              "type": "boolean"
            },
            "holder": {
              "type": "boolean"
            },
            "positionNumber": {
              "type": "boolean"
            }
          }
        },
        "filter": {
          "type": "object",
          "properties": {
            "focusUnitId": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^[a-z]_[a-z0-9]{10}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "showExternal": {
              "type": "boolean"
            },
            "date": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "topicTypes": {
              "oneOf": [
                {
                  "const": "all"
                },
                {
                  "type": "array",
                  "items": {
                    "enum": ["project", "workingGroup", "committee", "crossCutting", "other"]
                  }
                }
              ]
            },
            "hiddenTopics": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z]_[a-z0-9]{10}$"
              }
            },
            "relationKinds": {
              "oneOf": [
                {
                  "const": "all"
                },
                {
                  "type": "array",
                  "items": {
                    "enum": ["reportsTo", "directs", "informs", "coordinates"]
                  }
                }
              ]
            }
          }
        },
        "tree": {
          "type": "object",
          "properties": {
            "orientation": {
              "enum": ["top-down", "left-right"]
            },
            "stackLeaves": {
              "type": "boolean"
            }
          }
        },
        "network": {
          "type": "object",
          "properties": {
            "pinned": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": ["x", "y"],
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
